# =====================================================================
#  XENTRA DATACLINIC - Variables de entorno
#  1) Copie este archivo:   cp .env.example .env
#  2) Cambie TODOS los valores marcados con CAMBIAR antes de producción
#  3) NUNCA suba el archivo .env a GitHub (ya está en .gitignore)
# =====================================================================

# --- Base de datos PostgreSQL ---
# Dueño de las tablas (solo lo usan las migraciones):
POSTGRES_USER=xentra
POSTGRES_PASSWORD=CAMBIAR_clave_bd_muy_segura
POSTGRES_DB=xentra_hce
DATABASE_URL_MIGRACIONES=postgresql+psycopg://xentra:CAMBIAR_clave_bd_muy_segura@db:5432/xentra_hce
# Usuario SIN privilegios con el que corre la API (no puede borrar auditoría ni desactivar triggers):
APP_DB_PASSWORD=CAMBIAR_clave_usuario_aplicacion
DATABASE_URL=postgresql+psycopg://xentra_app:CAMBIAR_clave_usuario_aplicacion@db:5432/xentra_hce

# --- Seguridad ---
# Genere valores aleatorios con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_clave_jwt_aleatoria_de_64_caracteres
# Llave del libro mayor (ledger tipo blockchain). Guárdela FUERA de la base de datos
# (idealmente en un gestor de secretos). Si se pierde no se pueden verificar firmas antiguas.
LEDGER_HMAC_KEY=CAMBIAR_llave_ledger_aleatoria_de_64_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Protocolos de seguridad (docs/manuales/04-PROTOCOLOS-SEGURIDAD.md) ---
# Portal del paciente: false = los pacientes NO ingresan a la plataforma
PORTAL_PACIENTE_ACTIVO=false
# Obligar a cambiar la clave temporal en el primer ingreso
CAMBIO_CLAVE_PRIMER_INGRESO=true
# Roles que no pueden trabajar sin segundo factor (vacío = MFA opcional). Recomendado en producción:
# MFA_OBLIGATORIO_ROLES=admin,admin_tecnico,auditor,auditor_sistemas,medico,facturacion
MFA_OBLIGATORIO_ROLES=

# --- Usuario administrador inicial (se crea al primer arranque) ---
ADMIN_EMAIL=admin@xentra.co
ADMIN_PASSWORD=CAMBIAR_Admin123*

# --- Datos del prestador (IPS) para RIPS - Resolución 2275 de 2023 ---
PRESTADOR_NIT=900000000
PRESTADOR_COD_HABILITACION=110010000001
PRESTADOR_RAZON_SOCIAL=IPS DEMO XENTRA SAS

# --- Inteligencia artificial (opcional) ---
# local  = motor propio sin internet (por defecto)
# claude = usa la API de Anthropic (requiere ANTHROPIC_API_KEY y autorización de tratamiento de datos)
IA_PROVEEDOR=local
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# --- Integraciones externas ("simulado" para pruebas, "real" en producción) ---
# DIAN: a través de su proveedor tecnológico de facturación electrónica (ver backend/app/services/integraciones.py)
DIAN_MODO=simulado
DIAN_PROVEEDOR_URL=
DIAN_PROVEEDOR_TOKEN=
FACTURA_PREFIJO=FEV
# MUV del Ministerio (API FEV-RIPS)
MUV_MODO=simulado
MUV_URL=https://localhost:9443
MUV_TIPO_USUARIO=RE
MUV_USUARIO=
MUV_CLAVE=
# RDA - Resolución 1888 de 2025 (obligatorio desde 15/04/2026) y Res. 1799 de 2026 (dispensación, hasta 01/03/2027)
# Modo: simulado | real | desactivado
RDA_MODO=simulado
# URL del API Gateway de la IHCE y credencial: las asigna el Ministerio al registrar la IPS en la IHCE.
# No use una URL genérica: si no la tiene, deje RDA_MODO=simulado.
IHCE_URL=
IHCE_TOKEN=
# URL canónica oficial de los perfiles (guía FHIR RDA - vulcano.ihcecol.gov.co). No cambiar salvo nueva versión de la guía.
RDA_PERFIL_BASE=https://fhir.minsalud.gov.co/rda/StructureDefinition
# Ruta de la operación "Enviar Dispensación" (Res. 1799 de 2026): confírmela con la IHCE al registrarse
RDA_OPERACION_DISPENSACION=
# Anclaje del ledger: local | opentimestamps
ANCLAJE_MODO=local
# Telemedicina (recomendado: servidor Jitsi propio)
JITSI_URL=https://meet.jit.si

# --- Otros ---
ZONA_HORARIA=America/Bogota
# Dirección pública del sistema (se imprime en los QR de verificación de documentos)
URL_PUBLICA=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CARGAR_DATOS_DEMO=true
# Dominio para HTTPS automático (solo docker-compose.prod.yml)
DOMINIO=hce.miips.com
# Túnel de Cloudflare para publicar desde su propio equipo (docker-compose.tunel.yml).
# Guía: docs/12-despliegue-servidor-propio.md. El token es SECRETO: nunca lo suba a GitHub.
CLOUDFLARE_TUNNEL_TOKEN=
# HCE privada por VPN WireGuard (docker-compose.vpn.yml). Guía: docs/13-hce-privada-vpn.md
# VPN_HOST: su IP pública o dominio DuckDNS. VPN_PANEL_HASH: entre comillas simples.
VPN_HOST=
VPN_PANEL_HASH=''
DUCKDNS_SUBDOMINIO=
DUCKDNS_TOKEN=
# Días que se conservan los respaldos locales
RESPALDO_DIAS=14
