# =====================================================================
#  XENTRA DATACLINIC - Variables de entorno
#  1) Copie este archivo:   cp .env.example .env
#  2) Cambie TODOS los valores marcados con CAMBIAR antes de producción
#  3) NUNCA suba el archivo .env a GitHub (ya está en .gitignore)
# =====================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=xentra
POSTGRES_PASSWORD=CAMBIAR_clave_bd_muy_segura
POSTGRES_DB=xentra_hce
DATABASE_URL=postgresql+psycopg://xentra:CAMBIAR_clave_bd_muy_segura@db:5432/xentra_hce

# --- Seguridad ---
# Genere valores aleatorios con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_clave_jwt_aleatoria_de_64_caracteres
# Llave del libro mayor (ledger tipo blockchain). Guárdela FUERA de la base de datos
# (idealmente en un gestor de secretos). Si se pierde no se pueden verificar firmas antiguas.
LEDGER_HMAC_KEY=CAMBIAR_llave_ledger_aleatoria_de_64_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Usuario administrador inicial (se crea al primer arranque) ---
ADMIN_EMAIL=admin@xentra.co
ADMIN_PASSWORD=CAMBIAR_Admin123*

# --- Datos del prestador (IPS) para RIPS - Resolución 2275 de 2023 ---
PRESTADOR_NIT=900000000
PRESTADOR_COD_HABILITACION=110010000001
PRESTADOR_RAZON_SOCIAL=IPS DEMO XENTRA SAS

# --- Inteligencia artificial (opcional) ---
# local  = motor propio sin internet (por defecto)
# claude = usa la API de Anthropic (requiere ANTHROPIC_API_KEY y autorización de tratamiento de datos)
IA_PROVEEDOR=local
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# --- Otros ---
ZONA_HORARIA=America/Bogota
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CARGAR_DATOS_DEMO=true
